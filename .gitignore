# ============================================
# NEXT.JS SPECIFIC
# ============================================

# Next.js build output
.next/
out/
build/
dist/

# Next.js static files
!.next/static

# ============================================
# DEPENDENCIES
# ============================================

# Node.js
node_modules/
package-lock.json
yarn.lock
# NOTE: pnpm-lock.yaml MUST be committed for CI (`pnpm install --frozen-lockfile`
# and `actions/setup-node` caching both require the lockfile in the checkout).
bun.lockb

# ============================================
# ENVIRONMENT VARIABLES
# ============================================

# Environment files (CRITICAL - NEVER COMMIT!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Environment files with secrets
.env.secrets
*.env.secrets

